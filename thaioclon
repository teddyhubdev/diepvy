local function recoveredAuthEqual(left, right)
    local copiedLeft, copiedRight = nil, nil
    local copied = pcall(function()
        copiedLeft, copiedRight = left, right
    end)
    if not copied or copiedLeft == nil or copiedRight == nil then
        return false
    end
    if type(copiedLeft) ~= type(copiedRight) then
        return false
    end
    local aliases = { copiedRight, copiedLeft, copiedRight, copiedLeft }
    if aliases[1] ~= aliases[1] then
        return false
    end
    if aliases[1] ~= aliases[2] or aliases[2] ~= aliases[1] then
        return false
    end
    local truthyValue, nilValue, booleanInvariant = 1 and 2, 2 and nil, true == not (not true)
    if type(copiedLeft) == "number" and type(copiedRight) == "number" then
        if truthyValue and booleanInvariant and not nilValue then
            return copiedLeft == copiedRight
        end
    elseif type(copiedLeft) == "string" and type(copiedRight) == "string" then
        if truthyValue and booleanInvariant then
            return copiedLeft == copiedRight
        end
    else
        return copiedLeft == copiedRight
    end
    return false
end
local function verifyCodecControlFlow()
    local timeValue = 12345
    if type(os) == "table" and type(os.time) == "function" then
        local timeOk, observedTime = pcall(os.time)
        if not timeOk or type(observedTime) ~= "number" then
            failAntiTamper("C1", "os.time did not return a number")
        end
        timeValue = observedTime
    end
    if string.find(tostring(print), "function", 1, true) == nil then
        failAntiTamper("C1", "print no longer has a function identity")
    end
    if string.find(tostring(type), "function", 1, true) == nil then
        failAntiTamper("C1", "type no longer has a function identity")
    end
    if (timeValue * timeValue + timeValue) % 2 ~= 0 then
        failAntiTamper("C1", "integer parity invariant failed")
    end
    if not recoveredAuthEqual(timeValue, timeValue) then
        failAntiTamper("C1", "reflexive equality invariant failed")
    end
    local state = 17
    local transitions = { [17] = 23, [23] = 41, [41] = 999 }
    local chars, bytes, clonedChars = {}, {}, {}
    local completed = false
    for _ = 1, 3 do
        if state == 17 then
            for byte = 0, 255 do
                local character = string.format("%c", byte)
                chars[byte] = character
                bytes[character] = byte
            end
            state = transitions[17]
        elseif state == 23 then
            for byte = 0, 255 do
                clonedChars[byte] = chars[byte]
            end
            state = transitions[23]
        elseif state == 41 then
            completed = recoveredAuthEqual(state, 41)
            state = transitions[41]
        else
            failAntiTamper("C1", "codec state machine left its recovered path")
        end
    end
    if not completed or state ~= 999 then
        failAntiTamper("C1", "codec state machine did not reach its terminal state")
    end
    for byte = 0, 255 do
        if clonedChars[byte] ~= chars[byte] or bytes[chars[byte]] ~= byte then
            failAntiTamper("C1", "codec character table integrity failed")
        end
    end
    return "verified"
end
local function validateDebugInfo(debugLibrary, requireDebugInfo)
    if type(debugLibrary) ~= "table" or type(debugLibrary.info) ~= "function" then
        if requireDebugInfo == true then
            failAntiTamper("D1", "debug.info is required but unavailable")
        end
        return "unavailable"
    end
    local acceptedInvalidStack = pcall(debugLibrary.info, math.huge, "f")
    if acceptedInvalidStack then
        failAntiTamper("D1", "debug.info accepted an invalid stack level")
    end
    return "verified"
end
local function isFiniteNumber(value)
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end
local function validateClockSource(options, runtime)
    local clock = options.clock
    local clockName = "options.clock"
    if type(clock) ~= "function" then
        clock = runtime.tick
        clockName = "runtime.tick"
    end
    if type(clock) ~= "function" and type(tick) == "function" then
        clock = tick
        clockName = "tick"
    end
    if type(clock) ~= "function" and type(os) == "table" and type(os.clock) == "function" then
        clock = os.clock
        clockName = "os.clock"
    end
    if type(clock) ~= "function" then
        failAntiTamper("T1", "no numeric clock source is available")
    end
    local firstOk, first = pcall(clock)
    local secondOk, second = pcall(clock)
    if not firstOk or not secondOk or not isFiniteNumber(first) or not isFiniteNumber(second) then
        failAntiTamper("T1", clockName .. " did not return finite numbers")
    end
    if second < first then
        failAntiTamper("T1", clockName .. " moved backwards during the preflight")
    end
    if not recoveredAuthEqual(first, first) or not recoveredAuthEqual(second, second) then
        failAntiTamper("T1", clockName .. " failed the equality invariant")
    end
    return clockName
end
local function resolveOptionalFunction(explicitValue, runtime, runtimeName, globalValue)
    if explicitValue ~= nil then
        if type(explicitValue) ~= "function" then
            failAntiTamper("H6", runtimeName .. " was supplied with a non-function value")
        end
        return explicitValue
    end
    if type(runtime[runtimeName]) == "function" then
        return runtime[runtimeName]
    end
    if type(globalValue) == "function" then
        return globalValue
    end
    return nil
end
local function validateNativePrimitives(options, runtime)
    local isLuaClosure = resolveOptionalFunction(options.isLuaClosure,runtime,"islclosure",islclosure)
    local isSynapseFunction = resolveOptionalFunction(options.isSynapseFunction,runtime,"is_synapse_function",is_synapse_function)
    local classifierCount = 0
    local function classify(classifier, classifierName, primitive)
        if classifier == nil then
            return
        end
        classifierCount = classifierCount + 1
        local ok, classified = pcall(classifier, primitive.value)
        if not ok or type(classified) ~= "boolean" then
            failAntiTamper("H6", classifierName .. " rejected " .. primitive.name)
        end
        if classified then
            failAntiTamper("H6", primitive.name .. " is no longer a native primitive")
        end
    end
    for _, primitive in ipairs(AUTH_NATIVE_PRIMITIVES) do
        classify(isLuaClosure, "islclosure", primitive)
        classify(isSynapseFunction, "is_synapse_function", primitive)
    end
    if classifierCount == 0 then
        return "classifiers-unavailable"
    end
    return "verified"
end
local function resolveProxyFactory(options, runtime, debugLibrary)
    local proxyFactory = options.newproxy
    if proxyFactory ~= nil and type(proxyFactory) ~= "function" then
        failAntiTamper("P1", "newproxy was supplied with a non-function value")
    end
    if type(proxyFactory) == "function" then return proxyFactory end
    if type(runtime.newproxy) == "function" then  return runtime.newproxy end
    if type(newproxy) == "function" then return newproxy end
    if type(debugLibrary) == "table" and type(debugLibrary.getregistry) == "function" then
        local registryOk, registry = pcall(debugLibrary.getregistry)
        if registryOk and type(registry) == "table" and type(registry.newproxy) == "function" then
            return registry.newproxy
        end
    end
    return nil
end
local function validateProxyTrap(proxyFactory)
    if proxyFactory == nil then
        return "unavailable"
    end
    local proxyOk, proxy = pcall(proxyFactory, true)
    if not proxyOk or proxy == nil then
        failAntiTamper("P1", "newproxy(true) failed")
    end
    local metatableOk, proxyMetatable = pcall(getmetatable, proxy)
    if not metatableOk or type(proxyMetatable) ~= "table" then
        failAntiTamper("P1", "newproxy(true) did not expose a writable metatable")
    end
    local token = {}
    local readKey = "__banana_auth_spy_trap_read"
    local writeKey = "__banana_auth_spy_trap_write"
    local observedWriteKey, observedWriteValue = nil, nil
    local tostringCalls = 0
    local configured = pcall(function()
        proxyMetatable.__index = function(_, key)
            if key == readKey then
                return token
            end
            return nil
        end
        proxyMetatable.__newindex = function(_, key, value)
            observedWriteKey, observedWriteValue = key, value
        end
        proxyMetatable.__tostring = function()
            tostringCalls = tostringCalls + 1
            return "banana-auth-spy-trap"
        end
    end)
    if not configured then
        failAntiTamper("P1", "proxy metamethod trap could not be installed")
    end
    local trapOk, observedRead, observedText = pcall(function()
        local readValue = proxy[readKey]
        proxy[writeKey] = token
        return readValue, tostring(proxy)
    end)
    if not trapOk or observedRead ~= token or observedWriteKey ~= writeKey or observedWriteValue ~= token or observedText ~= "banana-auth-spy-trap" 
    or tostringCalls ~= 1 then
        failAntiTamper("P1", "proxy spy trap did not observe the expected metamethod path")
    end
    return "verified"
end

local function observeStackIntegrity(options, debugLibrary)
    local getstack = type(debugLibrary) == "table" and debugLibrary.getstack or nil
    local setstack = type(debugLibrary) == "table" and debugLibrary.setstack or nil
    local stackApis = type(getstack) == "function" and type(setstack) == "function"
    if options.stackIntegrityProbe == nil then
        return stackApis and "available-boundary" or "unavailable"
    end
    if type(options.stackIntegrityProbe) ~= "function" then
        failAntiTamper("S1", "stackIntegrityProbe must be a function")
    end
    local probeOk, probePassed = pcall(options.stackIntegrityProbe, { debugLibrary = debugLibrary, getstack = getstack, setstack = setstack, })
    if not probeOk or probePassed ~= true then
        failAntiTamper("S1", "the supplied stack integrity probe failed")
    end
    return "verified"
end
function RecoveredBootstrap.runAntiTamperPreflight(options)
    options = options or {}
    local runtime = options.runtime or resolveRuntimeEnvironment()
    local debugLibrary = options.debugLibrary or runtime.debug or debug
    local proxyFactory = resolveProxyFactory(options, runtime, debugLibrary)
    local nativePrimitiveStatus = "proxy-unavailable"
    if proxyFactory ~= nil then
        nativePrimitiveStatus = validateNativePrimitives(options, runtime)
    end
    local report = {
        codecControlFlow = verifyCodecControlFlow(),
        debugInfo = validateDebugInfo(debugLibrary, options.requireDebugInfo),
        clockSource = validateClockSource(options, runtime),
        nativePrimitives = nativePrimitiveStatus,
    }
    report.proxyTrap = validateProxyTrap(proxyFactory)
    report.stackIntegrity = observeStackIntegrity(options, debugLibrary)
    local cryptoIntegrityProbe = options.cryptoIntegrityProbe or RecoveredBootstrap.cryptoIntegrityProbe
    if type(cryptoIntegrityProbe) ~= "function" then
        failAntiTamper("C2", "the embedded codec integrity probe is unavailable")
    end
    local cryptoOk, cryptoPassed = pcall(cryptoIntegrityProbe)
    if not cryptoOk or cryptoPassed ~= true then
        failAntiTamper("C2", "the embedded codec round trip failed")
    end
    report.cryptoRoundTrip = "verified"
    report.passed = true
    return report
end
local function readKey(runtime)
