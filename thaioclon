local function recoveredBuildVerificationProof(params)
    local key = params.key or ""
    local device = params.device or ""
    local session = params.session or ""
    local challenge = params.challenge or ""
    
    local function simpleHash(str)
        local hash = 0
        for i = 1, #str do
            local byte = string.byte(str, i)
            hash = (hash * 31 + byte) % 0xFFFFFFFF
        end
        return tostring(hash)
    end
    
    return {
        k = key,
        w = simpleHash(key .. device),
        p = simpleHash(device .. session),
        n = simpleHash(session .. challenge),
        v = simpleHash(challenge .. key),
        s = session,
        r = simpleHash(key .. device .. session .. challenge)
    }
end

local function recoveredComputeStep(params)
    local a = params.a or ""
    local b = params.b or ""
    local key = params.key or ""
    
    local function simpleCompute(str1, str2)
        local result = 0
        for i = 1, math.max(#str1, #str2) do
            local byte1 = string.byte(str1, i) or 0
            local byte2 = string.byte(str2, i) or 0
            result = (result + byte1 * byte2) % 0xFFFFFFFF
        end
        return tostring(result)
    end
    
    return simpleCompute(a .. key, b .. key)
end

