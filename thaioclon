        writefile(CONFIG.SAVE_PATH, HttpService:JSONEncode(Cache))
    end)
end

Cache = loadCache()

local function translateSingle(text, targetLang)
    if not http_request and not request then return nil, true end
    local httpFunc = http_request or request

    local url = string.format(
        "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=%s&dt=t&q=%s",
        targetLang,
        HttpService:UrlEncode(text)
    )

    local success, response = pcall(function()
        return httpFunc({ Url = url, Method = "GET" })
    end)

    if not success or not response then
        return nil, false -- network fail -> retry
    end

    local status = tonumber(response.StatusCode or response.Status or 0) or 0
    if status == 429 or status >= 500 then
        return nil, false -- rate limit / server error -> retry
    end
    if status ~= 0 and status ~= 200 then
        return nil, false -- HTTP error khác -> retry
    end

    if not response.Body or response.Body == "" then
        return nil, false
    end

    local ok, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
    if not ok or not data then
        return nil, false -- JSON parse fail -> retry
    end

    if data[1] and data[1][1] and data[1][1][1] then
        return data[1][1][1], true
    end

    return nil, true -- response hợp lệ nhưng trống
end

-- PARALLEL TRANSLATE với semaphore thực sự + retry backoff
local function batchTranslateParallel(messages, targetLang)
    local results = {}
    local toTranslate = {}
    local indices = {}

    -- Lấy từ cache trước
    for i, msg in ipairs(messages) do
        if Cache[msg] then
            results[i] = Cache[msg]
        else
            table.insert(toTranslate, msg)
            table.insert(indices, i)
        end
    end

    local total = #toTranslate
    if total == 0 then
        return results
    end

    local MAX_RETRIES = 3
    local BASE_DELAY = 0.5

    local active = 0
    local completed = 0
    local nextIdx = 1

    local function worker(taskIdx)
        local original = toTranslate[taskIdx]
        local resultIdx = indices[taskIdx]

        local translated
        for attempt = 1, MAX_RETRIES do
            local text, done = translateSingle(original, targetLang)
            if text then
                translated = text
                break
            end
            if done then
                -- API bảo không có bản dịch -> không retry
                break
            end
            -- Lỗi kỹ thuật -> backoff rồi retry
            task.wait(BASE_DELAY * attempt)
        end

        if translated then
            results[resultIdx] = translated
            Cache[original] = translated
        else
            results[resultIdx] = original
            -- KHÔNG cache khi fail -> lần sau CollectAndCache sẽ thử lại
        end

        active = active - 1
        completed = completed + 1
    end

    -- Semaphore: chỉ spawn khi có slot trống, chờ đến khi tất cả xong
    while completed < total do
        if active < CONFIG.PARALLEL_REQUESTS and nextIdx <= total then
            active = active + 1
            local idx = nextIdx
            nextIdx = nextIdx + 1
            task.spawn(worker, idx)
        else
            task.wait(0.05)
        end
    end

    return results
end

