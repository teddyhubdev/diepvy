        end
    end
    
    if #texts == 0 then
        return
    end
    
    -- Remove duplicates
    local unique = {}
    local seen = {}
    for _, text in ipairs(newTexts) do
        if not seen[text] then
            table.insert(unique, text)
            seen[text] = true
        end
    end
    
