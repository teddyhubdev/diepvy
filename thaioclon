        key = "DEMO_KEY_PLEASE_SET_REAL_KEY_123456"
    end
    return key
end
local function urlEncode(httpService, value)
    return httpService:UrlEncode(tostring(value))
end
local function encodeOrderedQuery(httpService, orderedPairs)
    local encoded = table.create(#orderedPairs)
    for index, pair in ipairs(orderedPairs) do
        encoded[index] = urlEncode(httpService, pair[1]) .. "=" .. urlEncode(httpService, pair[2])
    end
    return table.concat(encoded, "&")
end
local function randomNoise(randomSource)
    local nextInteger = randomSource or math.random
    return string.format("%08x%08x", nextInteger(0, 0x7fffffff), nextInteger(0, 0x7fffffff))
end
local function decodeResponse(httpService, response, label)
    -- FIX: Don't crash with assert, use safer checks
    if type(response) ~= "table" then
        warn(label .. " did not return a response table")
        return nil
    end
    
    local statusCode = response.StatusCode or response.Status
    if statusCode and (statusCode < 200 or statusCode >= 300) then
        warn(label .. " returned HTTP " .. tostring(statusCode))
        return nil
    end
    
    local body = response.Body or response.body
    if type(body) ~= "string" then
        warn(label .. " response body is missing")
        return nil
    end
    
    local ok, decoded = pcall(httpService.JSONDecode, httpService, body)
    if not ok or type(decoded) ~= "table" then
        warn(label .. " returned invalid JSON:", decoded)
        return nil
    end
    
    return decoded
end
local function requestJson(context, method, url, body)
    local requestOptions = { Url = url, Method = method, Headers = { ["Accept"] = "application/json", ["Content-Type"] = "application/json", }, }
    if body ~= nil then
        requestOptions.Body = context.httpService:JSONEncode(body)
    end
    return decodeResponse(context.httpService, context.request(requestOptions), method .. " " .. url)
end

local function requireSuccess(payload, label)
    -- FIX: Don't crash with assert
    if type(payload) ~= "table" then
        warn(label .. " payload is missing")
        return false
    end
    if payload.success ~= true then
        warn(label .. " rejected the request")
        return false
    end
    return true
end

local function performHandshake(context, key)
    local query = encodeOrderedQuery(context.httpService, {
        { "0fepo", randomNoise(context.random) },
        { "k3y98", randomNoise(context.random) },
        { "szy9c", randomNoise(context.random) },
        { "d", context.deviceValue or key },
    })
    
    local handshake = requestJson(context, "GET", AUTH_API_ROOT .. "/hsk?" .. query)
    
    -- FIX: Don't crash with assert
    if not handshake then
        warn("handshake request failed")
        return nil
    end
    
    if not requireSuccess(handshake, "handshake") then
        return nil
    end
    
    if handshake.d == nil then
        warn("handshake response is missing d")
        return nil
    end
    
    if handshake.s == nil then
        warn("handshake response is missing s")
        return nil
    end
    
    if handshake.c == nil then
        warn("handshake response is missing c")
        return nil
    end
    
    return handshake
end

local function verifyChallenge(context, key, handshake)
    local buildVerificationProof = context.buildVerificationProof
    
    -- FIX: Safe type check
    if type(buildVerificationProof) ~= "function" then
        warn("context.buildVerificationProof must be function")
        return nil
    end
    
    local proof = buildVerificationProof({
        key = key,
        device = handshake.d,
        session = handshake.s,
        challenge = handshake.c,
    })
    
    -- FIX: Don't crash with assert
    if type(proof) ~= "table" then
        warn("buildVerificationProof must return a table")
        return nil
    end
    
    -- FIX: Safe field checks
    if not proof.k then warn("verification proof is missing k"); return nil end
    if not proof.w then warn("verification proof is missing w"); return nil end
    if not proof.p then warn("verification proof is missing p"); return nil end
    if not proof.n then warn("verification proof is missing n"); return nil end
    if not proof.v then warn("verification proof is missing v"); return nil end
    if not proof.s then warn("verification proof is missing s"); return nil end
    if not proof.r then warn("verification proof is missing r"); return nil end
    
    local queryFields = {
        { "k", proof.k },
        { "w", proof.w },
        { "p", proof.p },
        { "n", proof.n },
        { "v", proof.v },
        { "s", proof.s },
        { "r", proof.r },
    }
    for _, name in ipairs(context.verificationNoiseNames or {}) do
        queryFields[#queryFields + 1] = { name, randomNoise(context.random) }
    end
    local verification = requestJson(context,"GET",AUTH_API_ROOT .. "/vrf?" .. encodeOrderedQuery(context.httpService, queryFields))
    
    -- FIX: Safe checks
    if not verification then
        warn("verification request failed")
        return nil
    end
    
    if not requireSuccess(verification, "verification") then
        return nil
    end
    
    if type(verification.data) ~= "table" then
        warn("verification response is missing data")
        return nil
    end
    
    if verification.data.version == nil then
        warn("verification response is missing data.version")
        return nil
    end
    
    if verification.data.val == nil then
        warn("verification response is missing data.val")
        return nil
    end
    
    if type(verification.data.steps) ~= "table" then
        warn("verification response is missing data.steps")
        return nil
    end
    
    if verification.data.steps.a == nil then
        warn("verification response is missing data.steps.a")
        return nil
    end
    
    if verification.data.steps.b == nil then
        warn("verification response is missing data.steps.b")
        return nil
    end
    
    return verification
end
local function submitStep(context, key, handshake, verification)
    local computeStep = context.computeStep
    
    -- FIX: Safe type check
    if type(computeStep) ~= "function" then
        warn("context.computeStep must be function")
        return nil
    end
    
    local steps = verification.data.steps
    local computedStep = computeStep({
        a = steps.a,
        b = steps.b,
        key = key,
        device = handshake.d,
        session = handshake.s,
        challenge = handshake.c,
        version = verification.data.version,
        value = verification.data.val,
    })
    
    -- FIX: Don't crash with assert
    if computedStep == nil then
        warn("computeStep returned nil")
        return nil
    end
    
    local submission = requestJson(context, "POST", AUTH_API_ROOT .. "/stp", {a = steps.a,b = computedStep,key = key,})
    
    if not submission then
        warn("step submission request failed")
        return nil
    end
    
    if not requireSuccess(submission, "step submission") then
        return nil
    end
    
    return submission
end
function RecoveredBootstrap.authenticate(options)
    options = options or {}
    local runtime = options.runtime or resolveRuntimeEnvironment()
    local antiTamper = RecoveredBootstrap.runAntiTamperPreflight({
        runtime = runtime,
        debugLibrary = options.debugLibrary,
        requireDebugInfo = options.requireDebugInfo,
        clock = options.clock,
        isLuaClosure = options.isLuaClosure,
        isSynapseFunction = options.isSynapseFunction,
        newproxy = options.newproxy,
        stackIntegrityProbe = options.stackIntegrityProbe,
        cryptoIntegrityProbe = options.cryptoIntegrityProbe,
    })
    local httpService = options.httpService or game:GetService("HttpService")
    local context = {
        runtime = runtime,
        httpService = httpService,
        request = options.request or resolveRequestFunction(runtime),
        random = options.random,
        deviceValue = options.deviceValue,
        buildVerificationProof = options.buildVerificationProof,
        computeStep = options.computeStep,
        verificationNoiseNames = options.verificationNoiseNames,
    }
    local key = readKey(runtime)
    
    -- FIX BUG #9: Check for nil returns
    local handshake = performHandshake(context, key)
    if not handshake then
        warn("[BANANA HUB] Handshake failed")
        return {
            antiTamper = antiTamper,
            key = key,
            success = false,
            error = "handshake_failed"
        }
    end
    
    local verification = verifyChallenge(context, key, handshake)
    if not verification then
        warn("[BANANA HUB] Verification failed")
        return {
            antiTamper = antiTamper,
            key = key,
            device = handshake.d,
            session = handshake.s,
            challenge = handshake.c,
            success = false,
            error = "verification_failed"
        }
    end
    
    local submission = submitStep(context, key, handshake, verification)
    if not submission then
        warn("[BANANA HUB] Step submission failed")
        return {
            antiTamper = antiTamper,
            key = key,
            device = handshake.d,
            session = handshake.s,
            challenge = handshake.c,
            version = verification.data and verification.data.version,
            value = verification.data and verification.data.val,
            steps = verification.data and verification.data.steps,
            success = false,
            error = "submission_failed"
        }
    end
    
    return {
        antiTamper = antiTamper,
        key = key,
        device = handshake.d,
        session = handshake.s,
        challenge = handshake.c,
        version = verification.data.version,
        value = verification.data.val,
        steps = verification.data.steps,
        submission = submission,
        success = true
    }
end
function RecoveredBootstrap.startConfigButtonBridge(options)
    options = options or {}
    local runtime = options.runtime or resolveRuntimeEnvironment()
    local request = options.request or resolveRequestFunction(runtime)
    local httpService = options.httpService or game:GetService("HttpService")
    local runService = options.runService or game:GetService("RunService")
    local players = options.players or game:GetService("Players")
    local optionRegistry = options.optionRegistry or Options
    local interval = options.interval or 2
    local lastCheck = 0
    return runService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastCheck < interval then
            return
        end
        lastCheck = now
        local authId = runtime.Key
        local userId = players.LocalPlayer.Name
        local url = string.format("%s/api/check-button-click?authId=%s&userId=%s",CONFIG_API_ROOT,httpService:UrlEncode(authId),httpService:UrlEncode(userId))  
        local ok, response = pcall(request, { Url = url, Method = "GET" })
        if not ok or type(response) ~= "table" or response.StatusCode ~= 200 then
            return
        end
        local decodedOk, payload = pcall(httpService.JSONDecode, httpService, response.Body)
        if not decodedOk or type(payload) ~= "table" or payload.buttonKey == nil then
            return
        end
        for title, option in pairs(optionRegistry) do
            if title == payload.buttonKey or option.name == payload.buttonKey then
                if type(option.callback) == "function" then
                    local callbackOk, callbackError = pcall(option.callback)
                    if not callbackOk then
                        warn("Config button callback failed:", callbackError)
                    end
                end
                return
            end
        end
    end)
end
function RecoveredBootstrap.run(options)
    options = options or {}
    local session = {}
    
    -- FIX BUG #10: Wrap callbacks with pcall
    if type(options.onAuthenticated) == "function" then
        local success, err = pcall(options.onAuthenticated, session)
        if not success then
            warn("[BANANA HUB] onAuthenticated callback failed:", err)
        end
    end
    
    if options.startConfigBridge == true then
